# ── Server ─────────────────────────────────────────────
PORT=5000
# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:3000

# ── Data mode ──────────────────────────────────────────
# true  = GMDA records are replaced by clearly labelled synthetic records
#         ("DEMO DATA — NOT OFFICIAL"). Use only if GMDA is unreachable.
# false = live GMDA data only. Live mode NEVER silently falls back to demo data.
DEMO_MODE=false

# ── GMDA OneMap (official) ─────────────────────────────
GMDA_LAYER_URL=https://onemapdepts.gmda.gov.in/server/rest/services/flood_survey_2/FeatureServer/0
GMDA_SEARCH_RADIUS_M=1000
GMDA_TIMEOUT_MS=15000
# Optional: pin a field role to an exact GMDA field name after running
# `npm run inspect:gmda`. Leave blank to use automatic schema matching.
GMDA_FIELD_LOCALITY=
GMDA_FIELD_WATERLOGGING=
GMDA_FIELD_WATERLOGGINGDEPTH=
GMDA_FIELD_RWHSTATUS=
GMDA_FIELD_RWHCONDITION=
GMDA_FIELD_SURVEYDATE=

# ── Elevation ──────────────────────────────────────────
# Public Open-Elevation is rate-limited and sometimes down; you can self-host it.
ELEVATION_API_URL=https://api.open-elevation.com/api/v1/lookup
ELEVATION_RING_RADIUS_M=500

# ── Rainfall ───────────────────────────────────────────
# Open-Meteo needs no key. Reserved for a keyed provider (e.g. IMD after IP whitelisting).
RAINFALL_API_KEY=

# ── Geocoding (OpenStreetMap Nominatim) ────────────────
# Nominatim's usage policy requires an identifying User-Agent with contact info.
NOMINATIM_USER_AGENT=Pravah/0.2 (hackathon prototype; contact: you@example.com)
